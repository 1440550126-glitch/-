{
  "_说明": "SUNO 页面选择器与节奏。SUNO 会不定期改版，一旦脚本找不到输入框，先跑 `npm run inspect`，照着页面把下面的 selector 改对即可。每个字段是一组候选，脚本从上到下逐个尝试，命中即用——这样单个失效也不会全盘崩。",
  "createUrl": "https://suno.com/create",
  "selectors": {
    "customTab": [
      "role=tab[name=/custom/i]",
      "button:has-text(\"Custom\")",
      "text=/^Custom$/"
    ],
    "lyrics": [
      "textarea[placeholder*=\"lyrics\" i]",
      "textarea[data-testid*=\"lyric\" i]",
      "textarea[aria-label*=\"lyric\" i]",
      "textarea[placeholder*=\"歌词\"]"
    ],
    "style": [
      "textarea[placeholder*=\"style\" i]",
      "input[placeholder*=\"style\" i]",
      "textarea[placeholder*=\"genre\" i]",
      "textarea[aria-label*=\"style\" i]",
      "textarea[placeholder*=\"风格\"]"
    ],
    "title": [
      "input[placeholder*=\"title\" i]",
      "input[aria-label*=\"title\" i]",
      "input[placeholder*=\"标题\"]",
      "input[placeholder*=\"歌名\"]"
    ],
    "instrumentalToggle": [
      "role=switch[name=/instrumental/i]",
      "text=/instrumental/i"
    ],
    "createButton": [
      "button:has-text(\"Create\")",
      "button:has-text(\"创作\")",
      "button:has-text(\"Generate\")",
      "button[type=submit]:has-text(\"Create\")"
    ],
    "loginWall": [
      "text=/sign in/i",
      "text=/log in/i",
      "text=/登录/",
      "a[href*=\"sign-in\"]"
    ],
    "errorToast": [
      "text=/not enough credits/i",
      "text=/out of credits/i",
      "text=/insufficient/i",
      "text=/credits remaining/i",
      "text=/额度不足/",
      "text=/too many/i",
      "text=/limit/i"
    ],
    "creditsBadge": [
      "text=/credits/i",
      "[data-testid*=\"credit\" i]"
    ],
    "playlist": {
      "_说明": "SUNO 歌单归类（best-effort UI）。{title}/{name} 会被替换成实际歌名/歌单名。改版后按 npm run inspect 在资料库页核对更新。",
      "libraryUrl": "https://suno.com/me",
      "search": ["input[placeholder*=\"search\" i]", "input[type=\"search\"]", "input[placeholder*=\"搜索\"]"],
      "rowByTitle": ["[role=\"row\"]:has-text(\"{title}\")", "div:has-text(\"{title}\")>>nth=0", "a:has-text(\"{title}\")"],
      "rowMenu": ["button[aria-label*=\"more\" i]", "button[aria-haspopup=\"menu\"]", "button:has-text(\"⋯\")", "[data-testid*=\"menu\" i]"],
      "addToPlaylist": ["text=/add to playlist/i", "text=/加入歌单/", "[role=\"menuitem\"]:has-text(\"Playlist\")"],
      "playlistSearch": ["input[placeholder*=\"playlist\" i]", "input[placeholder*=\"歌单\"]", "input[type=\"search\"]"],
      "playlistOption": ["text=/^{name}$/", "[role=\"option\"]:has-text(\"{name}\")", "button:has-text(\"{name}\")"],
      "createPlaylist": ["text=/create.*playlist/i", "text=/新建歌单/", "button:has-text(\"Create\")"]
    }
  },
  "timing": {
    "betweenSongsMs": 45000,
    "acceptWaitMs": 20000,
    "actionTimeoutMs": 30000
  }
}
