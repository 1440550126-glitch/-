# ===== SUNO 批量挂机 · 配置（复制为 .env） =====
# 大模型（OpenAI 兼容，任意厂商：火山方舟/DeepSeek/OpenAI/阿里百炼…）
# 复用你主项目 .env 里的同名变量即可，只放本机、别下发
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL_DEFAULT=doubao-seed-1-6-250615

# 歌词/曲风生成的默认语言与风格倾向（可在 CSV 每行单独覆盖）
# 语言支持三种：中文 / 英文 / 双语（双语=主歌中文+副歌英文，SUNO 很讨喜的做法）
DEFAULT_LANGUAGE=中文
DEFAULT_MOOD=

# ===== 网页控制面板 =====
PANEL_PORT=8787
# 挂机时是否自动下载生成好的音频到 var/downloads/（best-effort，见 README）
DOWNLOAD=false

# ===== 挂机节奏（保守默认，别把账号刷崩） =====
# 每首歌之间的等待毫秒数（会在 ±30% 内随机抖动，更像真人）
BETWEEN_SONGS_MS=45000
# 点了「生成」后，判定是否被接受的最长等待毫秒
ACCEPT_WAIT_MS=20000
# 单个页面操作超时毫秒
ACTION_TIMEOUT_MS=30000

# ===== 浏览器 =====
# 登录态持久化目录（登录一次，之后复用；别提交到 git）
USER_DATA_DIR=.suno-profile
# 是否无头（挂机建议 false，能看到窗口；true 时看不见但更省资源）
HEADLESS=false
