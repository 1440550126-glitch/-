{
  "name": "suno-batch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SUNO 批量挂机：读 CSV → 大模型生成歌名/曲风/歌词 → Playwright 自动填表并生成",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/run.js",
    "panel": "node src/panel.js",
    "daily": "node src/scheduler.js",
    "dry": "node src/run.js --dry-run",
    "inspect": "node src/run.js --inspect",
    "gen": "node src/run.js --generate-only",
    "login": "node src/run.js --login-only",
    "download": "node src/run.js --download",
    "retry": "node src/run.js --retry-only",
    "check": "for f in src/*.js; do node --check \"$f\" || exit 1; done && echo OK"
  },
  "dependencies": {
    "playwright": "^1.48.0"
  }
}
